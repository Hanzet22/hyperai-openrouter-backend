# Vercel Environment Variables
# This is an example template only. Never commit a real API key.
# Configure real values in Vercel Project Settings -> Environment Variables.

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_APP_TITLE=HyperAI
PUBLIC_APP_URL=https://hyperai-hg.vercel.app/

# Optional: one browser origin, or comma-separated origins.
# This is a CORS control, not authentication.
# ALLOWED_ORIGIN=https://YOUR-DOMAIN.vercel.app

# Optional: OpenRouter web search may add charges beyond model token usage.
# Set to true only after reviewing pricing and intentionally enabling it.
ENABLE_OPENROUTER_WEB_SEARCH=true