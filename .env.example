# Vercel Environment Variables
# Example template only. Never commit a real API key.
# Configure real values in Vercel Project Settings -> Environment Variables.

OPENROUTER_API_KEY=replace_with_your_openrouter_api_key

# Emergency server-side switch. Set false to block all AI API requests.
HYPERAI_AI_ENABLED=true
OPENROUTER_APP_TITLE=HyperAI
PUBLIC_APP_URL=https://YOUR-DOMAIN.vercel.app

# Optional: one browser origin, or comma-separated origins.
# This is a CORS control, not authentication.
# ALLOWED_ORIGIN=https://YOUR-DOMAIN.vercel.app

# Optional: OpenRouter web search may add charges beyond model token usage.
# Set to true only after reviewing pricing and intentionally enabling it.
ENABLE_OPENROUTER_WEB_SEARCH=false

# Required in Vercel Production and Preview for distributed API rate limiting (Upstash Redis REST).
# Keep both values private; do not expose them to browser code.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_upstash_rest_token

# Optional shared-password access gate. Enable only after setting both secrets.
# Use a unique password of at least 12 characters and a random session secret of at least 32 characters.
# HYPERAI_AUTH_REQUIRED=true
# HYPERAI_ACCESS_PASSWORD=replace_with_a_unique_long_password
# HYPERAI_SESSION_SECRET=replace_with_at_least_32_random_characters
